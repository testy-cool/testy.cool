{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "testycool-stream",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "testycool-stream",
      "database_id": "b83925e3-01e9-45e6-95b3-04d062ad1dfa",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
